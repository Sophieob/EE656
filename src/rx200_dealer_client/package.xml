<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rx200_dealer_client</name>
  <version>0.1.0</version>
  <description>ROS 2 card-dealing project built around the Interbotix RX200 robotic arm</description>
  <maintainer email="sophie.obrien.2021@mumail.ie">Maynooth University MSc. Robotics and Embedded AI Group 5</maintainer>
  <license>MIT</license>

  <exec_depend>ros2launch</exec_depend>
  <exec_depend>interbotix_xsarm_moveit</exec_depend>
  
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <depend>rclpy</depend>
  <depend>moveit_msgs</depend>
  <depend>shape_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>quaternion_from_euler</depend>
  <depend>rx200_dealer_interfaces</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
